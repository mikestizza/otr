apiVersion: v1
kind: ConfigMap
metadata:
  name: otr-catalog
  namespace: stizlab-xsc2x
data:
  site.txt: |
    SITE_PLACEHOLDER
  index.html: |
    <!DOCTYPE html>
    <html lang="en">
    <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OTR Wheel Engineering — Service Status</title>
    <style>
      :root{
        --concrete:#D5D2CA;
        --panel:#E4E2DC;
        --ink:#191C1E;
        --ink-soft:#5A5E60;
        --rule:#A9A69E;
        --site-a:#F2B705;
        --site-b:#2E6E8E;
        --fault:#B3241C;
      }
      *{box-sizing:border-box}
      html,body{margin:0;padding:0}
      body{
        background:var(--concrete);
        color:var(--ink);
        font-family:"Helvetica Neue",Arial,system-ui,sans-serif;
        -webkit-font-smoothing:antialiased;
        min-height:100vh;
        display:flex;
        justify-content:center;
        padding:32px 20px 48px;
      }
      .board{width:100%;max-width:960px}
    
      header{
        display:flex;
        justify-content:space-between;
        align-items:baseline;
        padding-bottom:14px;
        border-bottom:3px solid var(--ink);
      }
      .mark{
        font-size:19px;
        font-weight:800;
        letter-spacing:.14em;
        text-transform:uppercase;
      }
      .mark span{font-weight:400;letter-spacing:.06em;color:var(--ink-soft)}
      .release{
        font-size:14px;
        font-weight:700;
        color:var(--ink-soft);
        letter-spacing:.03em;
      }
    
      .lede{
        margin:26px 0 10px;
        font-size:15px;
        color:var(--ink-soft);
        letter-spacing:.02em;
      }
    
      /* the one loud element */
      .plate{
        border:4px solid var(--ink);
        background:var(--panel);
        padding:38px 32px 30px;
        text-align:center;
        position:relative;
        transition:background-color .18s linear;
      }
      .plate.flash{background:#fff}
      .plate .site{
        font-size:clamp(64px,15vw,148px);
        line-height:.86;
        font-weight:800;
        letter-spacing:.06em;
        margin:0;
      }
      .plate .where{
        margin-top:16px;
        font-size:15px;
        font-weight:600;
        color:var(--ink-soft);
        letter-spacing:.05em;
      }
      .lamp{
        position:absolute;
        top:0;left:0;right:0;
        height:14px;
        background:var(--rule);
      }
      .plate[data-site="A"] .lamp{background:var(--site-a)}
      .plate[data-site="B"] .lamp{background:var(--site-b)}
      .plate[data-site="A"] .site{color:var(--ink)}
      .plate[data-site="B"] .site{color:var(--site-b)}
      .plate[data-site="FAULT"] .lamp{background:var(--fault)}
      .plate[data-site="FAULT"] .site{color:var(--fault);font-size:clamp(40px,9vw,88px)}
    
      .readout{
        display:grid;
        grid-template-columns:repeat(4,1fr);
        border:3px solid var(--ink);
        border-top:0;
      }
      .cell{padding:16px 18px;border-right:1px solid var(--rule)}
      .cell:last-child{border-right:0}
      .cell .n{font-size:30px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
      .cell .k{margin-top:6px;font-size:12px;color:var(--ink-soft);letter-spacing:.04em}
      .cell.bad .n{color:var(--fault)}
    
      .ledger{margin-top:34px}
      .ledger h2{
        font-size:14px;
        font-weight:700;
        letter-spacing:.1em;
        margin:0 0 10px;
        padding-bottom:8px;
        border-bottom:2px solid var(--ink);
      }
      ol{
        list-style:none;
        margin:0;padding:0;
        font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
        font-size:13.5px;
        max-height:270px;
        overflow:hidden;
      }
      li{
        display:grid;
        grid-template-columns:96px 1fr 74px;
        gap:14px;
        padding:7px 2px;
        border-bottom:1px solid var(--rule);
      }
      li .t{color:var(--ink-soft)}
      li .s{font-weight:700}
      li[data-site="A"] .s{color:#8A6800}
      li[data-site="B"] .s{color:var(--site-b)}
      li[data-site="FAULT"] .s{color:var(--fault)}
      li .ms{text-align:right;color:var(--ink-soft);font-variant-numeric:tabular-nums}
    
      footer{margin-top:30px;font-size:13px;color:var(--ink-soft)}
    
      @media (prefers-reduced-motion:reduce){.plate{transition:none}}
      @media (max-width:620px){
        .readout{grid-template-columns:repeat(2,1fr)}
        .cell:nth-child(2){border-right:0}
        .cell:nth-child(1),.cell:nth-child(2){border-bottom:1px solid var(--rule)}
      }
    </style>
    </head>
    <body>
    <div class="board">
    
      <header>
        <div class="mark">OTR Wheel <span>Engineering</span></div>
        <div class="release" id="release">Release v1.0</div>
      </header>
    
      <p class="lede">Live check of the order catalog service, once per second.</p>
    
      <div class="plate" id="plate" data-site="A">
        <div class="lamp"></div>
        <h1 class="site" id="siteName">SITE A</h1>
        <div class="where" id="siteWhere">Phoenix &middot; cluster 221</div>
      </div>
    
      <div class="readout">
        <div class="cell"><div class="n" id="ok">0</div><div class="k">Requests served</div></div>
        <div class="cell bad"><div class="n" id="bad">0</div><div class="k">Failed</div></div>
        <div class="cell"><div class="n" id="switches">0</div><div class="k">Site changes</div></div>
        <div class="cell"><div class="n" id="clock">00:00</div><div class="k">Watching for</div></div>
      </div>
    
      <section class="ledger">
        <h2>Request ledger</h2>
        <ol id="log"></ol>
      </section>
    
      <footer id="foot">Polling /site.txt</footer>
    
    </div>
    
    <script>
    (function(){
      const plate=document.getElementById('plate'),
            siteName=document.getElementById('siteName'),
            siteWhere=document.getElementById('siteWhere'),
            okEl=document.getElementById('ok'),
            badEl=document.getElementById('bad'),
            swEl=document.getElementById('switches'),
            clockEl=document.getElementById('clock'),
            log=document.getElementById('log'),
            foot=document.getElementById('foot');
    
      const WHERE={A:'Phoenix &middot; cluster 221',B:'Phoenix &middot; cluster 220',FAULT:'No site responding'};
      let ok=0,bad=0,switches=0,last=null,started=Date.now();
    
      // Opened from disk: run a scripted preview so the page can be reviewed offline.
      const preview = location.protocol==='file:';
      let tick=0;
      if(preview) foot.textContent='Preview mode — scripted sample, not live data.';
    
      function paint(site,ms){
        if(site!==last){
          if(last!==null){switches++;swEl.textContent=switches;}
          plate.dataset.site=site;
          siteName.textContent = site==='FAULT' ? 'NO RESPONSE' : 'SITE '+site;
          siteWhere.innerHTML = WHERE[site];
          plate.classList.add('flash');
          setTimeout(()=>plate.classList.remove('flash'),180);
          last=site;
        }
        const li=document.createElement('li');
        li.dataset.site=site;
        const t=new Date().toLocaleTimeString('en-GB');
        li.innerHTML='<span class="t">'+t+'</span>'+
                     '<span class="s">'+(site==='FAULT'?'no response':'Site '+site)+'</span>'+
                     '<span class="ms">'+(ms==null?'—':ms+' ms')+'</span>';
        log.prepend(li);
        while(log.children.length>40) log.lastChild.remove();
      }
    
      function clock(){
        const s=Math.floor((Date.now()-started)/1000);
        clockEl.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
      }
    
      async function poll(){
        clock();
        if(preview){
          tick++;
          // alternate, then a short outage, then settle on the survivor
          let site;
          if(tick>18 && tick<23) site='FAULT';
          else if(tick>=23) site='B';
          else site = tick%2 ? 'A':'B';
          if(site==='FAULT'){bad++;badEl.textContent=bad;paint('FAULT',null);}
          else{ok++;okEl.textContent=ok;paint(site,9+Math.floor(Math.random()*8));}
          return;
        }
        const t0=performance.now();
        try{
          const r=await fetch('site.txt?_='+Date.now(),{cache:'no-store'});
          if(!r.ok) throw new Error(r.status);
          const site=(await r.text()).trim().toUpperCase().replace(/^SITE\s*/,'');
          ok++;okEl.textContent=ok;
          paint(site,Math.round(performance.now()-t0));
        }catch(e){
          bad++;badEl.textContent=bad;
          paint('FAULT',null);
        }
      }
    
      poll();
      setInterval(poll,1000);
    })();
    </script>
    </body>
    </html>
    
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: otr-catalog
  namespace: stizlab-xsc2x
spec:
  replicas: 4
  selector:
    matchLabels: {app: otr-catalog}
  template:
    metadata:
      labels: {app: otr-catalog}
    spec:
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: {app: otr-catalog}
      containers:
      - name: web
        image: nginx:alpine
        ports: [{containerPort: 80}]
        readinessProbe:
          httpGet: {path: /site.txt, port: 80}
          initialDelaySeconds: 2
          periodSeconds: 2
        volumeMounts:
        - {name: html, mountPath: /usr/share/nginx/html}
      volumes:
      - name: html
        configMap: {name: otr-catalog}
---
apiVersion: v1
kind: Service
metadata:
  name: otr-catalog
  namespace: stizlab-xsc2x
spec:
  type: NodePort
  selector: {app: otr-catalog}
  ports:
  - port: 80
    targetPort: 80
    nodePort: 30081
